# ---- LLM ----
# ollama | openai | stub
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# Any OpenAI-compatible endpoint (OpenAI, Groq, vLLM, Together...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Embeddings ----
# sentence-transformers | ollama | hash (hash is a deterministic test-only embedder)
EMBEDDING_BACKEND=sentence-transformers
# Fast multilingual default. For best FR/AR quality use BAAI/bge-m3 (bigger, slower).
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Used when EMBEDDING_BACKEND=ollama (run: ollama pull bge-m3). No torch needed.
OLLAMA_EMBEDDING_MODEL=bge-m3

# ---- Vector store ----
# Leave QDRANT_URL empty to use embedded Qdrant stored under QDRANT_PATH.
QDRANT_URL=
QDRANT_PATH=data/index/qdrant

# ---- Retrieval ----
CHUNK_STRATEGY=recursive
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
CANDIDATES=20
# Below this best dense cosine score (and with no keyword hit) the system refuses without calling the LLM.
# Tune per embedding model using scripts/evaluate.py. bge-m3 ~0.50, multilingual-e5 ~0.80, hash (tests) 0.15.
MIN_DENSE_SCORE=0.50

# ---- Semantic cache ----
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.95

# ---- Access control ----
USERS_FILE=config/users.yaml
DATA_DIR=data
